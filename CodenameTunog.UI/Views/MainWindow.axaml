<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:vm="using:CodenameTunog.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="CodenameTunog.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Audiora"
        MinWidth="800" MinHeight="600"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        WindowDecorations="Full">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <DockPanel LastChildFill="True">
    <!-- Topbar -->
    <Grid WindowDecorationProperties.ElementRole="TitleBar"
          DockPanel.Dock="Top"
          Height="40"
          ColumnDefinitions="*,Auto"
          Background="{DynamicResource LayerFillColorDefaultBrush}">
    </Grid>

    <!-- Main Content -->
    <ui:FANavigationView x:Name="LeftNav"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        PaneDisplayMode="LeftCompact"
                        IsBackButtonVisible="False"
                        IsPaneOpen="False"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="LeftNav_SelectionChanged">
      <ui:FANavigationView.MenuItems>
        <ui:FANavigationViewItem Content="Home"
                                Tag="home"
                                IsSelected="True">
          <ui:FANavigationViewItem.IconSource>
            <ui:FASymbolIconSource Symbol="Home" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
      </ui:FANavigationView.MenuItems>

      <TransitioningContentControl x:Name="ContentFrame"
                                  Margin="4"
                                  Content="{Binding CurrentPage}" />
    </ui:FANavigationView>
  </DockPanel>
</Window>

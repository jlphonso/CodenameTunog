<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:CodenameTunog.UI.ViewModels"
             xmlns:container="using:CodenameTunog.UI.Views.Containers"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="CodenameTunog.UI.Views.Pages.HomePage"
             x:DataType="vm:HomeViewModel">

  <Design.DataContext>
    <vm:HomeViewModel/>
  </Design.DataContext>

  <DockPanel LastChildFill="True">
    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8"
            Margin="4"
            BoxShadow="0 4 8 -2 #40000000"
            DockPanel.Dock="Right">
      <container:PlayerContainer Width="400" />
    </Border>

    <Label>ts home cuhh</Label>
  </DockPanel>
</UserControl>

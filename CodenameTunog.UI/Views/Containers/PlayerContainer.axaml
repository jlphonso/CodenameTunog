<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:CodenameTunog.UI.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             x:Class="CodenameTunog.UI.Views.Containers.PlayerContainer"
             x:DataType="vm:PlayerContainerViewModel">

  <StackPanel>
    <RelativePanel Margin="10">
      <Border Name="MusicCover"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8"
              BoxShadow="0 4 8 -2 #40000000"
              RelativePanel.AlignHorizontalCenterWithPanel="True"
              RelativePanel.AlignTopWithPanel="True">
        <Panel ClipToBounds="True">
          <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                  IsVisible="{Binding MusicCover, Converter={x:Static ObjectConverters.IsNull}}">
            <ic:SymbolIcon Symbol="MusicNote2"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontSize="180" />
          </Border>
          <Image Margin="0"
                Height="400"
                Width="390"
                Source="{Binding MusicCover}"
                Stretch="Uniform" />
        </Panel>
      </Border>
      <TextBlock Name="MusicTitle"
                Text="{Binding MusicTitle, FallbackValue=Unknown Song}"
                FontWeight="SemiBold"
                FontSize="22"
                Margin="0,10,0,0"
                RelativePanel.Below="MusicCover" />
      <TextBlock Name="MusicArtist"
                Text="{Binding MusicArtist, FallbackValue=Unknown Artist}"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                FontSize="18"
                RelativePanel.Below="MusicTitle" />
    </RelativePanel>
    <StackPanel Margin="10">
      <Slider x:Name="TimePositionSlider" Value="25" />
    </StackPanel>
  </StackPanel>
</UserControl>
